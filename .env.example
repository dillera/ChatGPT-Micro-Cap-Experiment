# tastytrade OAuth2 (required for brokerage connection)
# Run: python scripts/get_refresh_token.py to obtain TT_REFRESH
TT_CLIENT_ID=your_client_id_here
TT_SECRET=your_client_secret_here
TT_REFRESH=your_refresh_token_here

# LLM API key — both bull and bear models routed through OpenRouter
OPENROUTER_API_KEY=sk-or-your-openrouter-key

# LLM Model selection — both routed through OpenRouter (openrouter.ai/models)
BULL_MODEL=qwen/qwen3.5-flash-02-23
# BULL_MODEL=openai/gpt-4o-mini     # fallback
BEAR_MODEL=moonshotai/kimi-k2.6
# BEAR_MODEL=anthropic/claude-sonnet-4-6  # fallback

# Financial Modeling Prep — economic calendar + macro event gate
# Free tier: real-time quotes only. Upgrade to starter ($19/mo) to unlock
# economic_calendar endpoint (FOMC/CPI/NFP pre-flight gate).
FMP_API_KEY=your_fmp_api_key_here

# Runtime
DRY_RUN=false
LOG_LEVEL=INFO

RESEARCH_MAX_MARKET_CAP=2000000000
RESEARCH_MIN_PRICE=2.0
RESEARCH_MAX_PER_RUN=30
EVAL_COOLDOWN_HOURS=24
